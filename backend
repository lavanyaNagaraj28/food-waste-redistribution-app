from Django. Shortcuts import render, redirect, get_object_or_404 
from django.contrib.auth.decorators import login_required 
from django.contrib import messages 
from .models import Claim 
from .forms import Claim Form 
from listings.models import FoodListing 
from notifications.utils import create_notification 
 
@login_required 
def claim_create(request, listing_pk): 
    listing = get_object_or_404(FoodListing, pk=listing_pk, status='available') 
    if request.user.is_donor(): 
  
        messages.error(request, 'Donors cannot claim food.') 
        return redirect('listing_detail', pk=listing_pk) 
    if Claim.objects.filter(listing=listing, receiver=request.user).exists(): 
        messages.warning(request, 'You have already claimed this listing.') 
        return redirect('listing_detail', pk=listing_pk) 
    if request.method == 'POST': 
        form = ClaimForm(request.POST) 
        if form.is_valid(): 
            claim = form.save(commit=False) 
            claim.listing  = listing 
            claim.receiver = request.user 
            claim.save() 
            create_notification( 
                listing.donor, 
                {request.user.username} has claimed your listing: " {listing.title}"' 
            ) 
            messages.success(request, 'Claim submitted! The donor will review it shortly.') 
            return redirect('my_claims') 
    else: 
        form = ClaimForm() 
    return render(request, 'claims/claim_form.html', {'form': form, 'listing': listing}) 
 
@login_required 
def my_claims(request): 
    claims = Claim.objects.filter(receiver=request.user).select_related('listing','listing__donor') 
    return render(request, 'claims/my_claims.html', {'claims': claims}) 
 
@login_required 
def donor_claims(request): 
    claims = Claim.objects.filter(listing__donor=request.user).select_related('listing','receiver') 
    return render(request, 'claims/donor_claims.html', {'claims': claims}) 
  
 
@login_required 
def claim_action(request, pk, action): 
    claim = get_object_or_404(Claim, pk=pk, listing__donor=request.user) 
    if action == 'approve' and claim.status == 'pending': 
        claim.status  = 'approved' 
        claim.listing.status = 'claimed' 
        claim.listing.save() 
        create_notification(claim.receiver) 
            Your claim for "{claim.listing.title}" has been approved!') 
        messages.success(request, 'Claim approved!') 
    elif action == 'reject' and claim.status == 'pending': 
        claim.status = 'rejected' 
        create_notification(claim.receiver, 
             Your claim for "{claim.listing.title}" was rejected.') 
        messages.info(request, 'Claim rejected.') 
    elif action == 'complete' and claim.status == 'approved': 
        claim.status         = 'completed' 
        claim.listing.status = 'completed' 
        claim.listing.save() 
        create_notification(claim.receiver) 
            Food pickup for "{claim. listing.title}" marked as completed!') 
        messages.success(request, 'Marked as completed!') 
    claim.save() 
    return redirect('donor_claims') 
 
@login_required 
def cancel_claim(request, pk): 
    claim = get_object_or_404(Claim, pk=pk, receiver=request.user) 
    if claim.status in ['pending', 'approved']: 
        claim.status = 'cancelled' 
  
        if claim.listing.status == 'claimed': 
            claim.listing.status = 'available' 
            claim.listing.save() 
        claim.save() 
        messages.success(request, 'Claim cancelled.') 
    return redirect('my_claims') 
 
