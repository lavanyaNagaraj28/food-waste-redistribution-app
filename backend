from Django. Shortcuts import render, redirect, get_object_or_404 
from Django.contrib.auth.decorators import login_required 
from Django.contrib import messages 
from Django.utils import time zone 
from .models import FoodListing, Category 
from .forms import Food Listing Form 
from notifications.utils import create_notification 
  
 
def home_view(request): 
    listings      = FoodListing.objects.filter( 
                        status='available', 
                        expiry_time__gt=timezone.now() 
                    ).order_by('-created_at')[:6] 
    categories    = Category.objects.all() 
    total_listings= FoodListing.objects.count() 
    total_saved   = FoodListing.objects.filter(status='completed').count() 
    return render(request, 'listings/home.html', { 
        'listings':       listings, 
        'categories':     categories, 
        'total_listings': total_listings, 
        'total_saved':    total_saved, 
    }) 
 
def listing_list(request): 
    listings   = FoodListing.objects.filter( 
                    status='available', 
                    expiry_time__gt=timezone.now() 
                 ) 
    category_id= request.GET.get('category') 
    veg_filter = request.GET.get('veg') 
    search     = request.GET.get('search', '') 
 
    if category_id: 
        listings = listings.filter(category_id=category_id) 
    if veg_filter == 'true': 
        listings = listings.filter(is_veg=True) 
    if search: 
        listings = listings.filter(title__icontains=search) 
  
 
    return render(request, 'listings/list.html', { 
        'listings': listings, 
        'categories': Category.objects.all(), 
        'selected_category': category_id, 
        'search': search, 
    }) 
 
def listing_detail(request, pk): 
    listing = get_object_or_404(FoodListing, pk=pk) 
    return render(request, 'listings/detail.html', {'listing': listing}) 
 
@login_required 
def listing_create(request): 
    if not request.user.is_donor(): 
        messages.error(request, 'Only donors can create listings.') 
        return redirect('listing_list') 
    if request.method == 'POST': 
        form = FoodListingForm(request.POST, request.FILES) 
        if form.is_valid(): 
            listing        = form.save(commit=False) 
            listing.donor  = request.user 
            listing.save() 
            messages.success(request, 'Food listing created successfully!') 
            return redirect('listing_detail', pk=listing.pk) 
    else: 
        form = Food Listing Form() 
    return render(request, 'listings/form.html', {'form': form, 'title': 'Donate Food'}) 
 
